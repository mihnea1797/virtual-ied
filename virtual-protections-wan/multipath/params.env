# params.env — every parameter of the two-path lab (phase 1), in one place.
#
# Read by the bring-up scripts (sourced) and by mp_sweep.py (parsed), so keep it to literal
# KEY=VALUE lines: no variable references, no command substitution. The topology file
# (vied-mp.clab.yml) holds only the wiring; every address, rate and delay comes from here.
#
# Values marked [paper] are the paper lab's, read back from its data plane on 2026-11-16.
# Values marked [x1.25] are paper values scaled for the 50 B VXLAN overhead (248/198 = 1.2525).

# ---------------- lab ----------------
LAB=vied-mp
PFX=clab-vied-mp
PATH_DEFAULT=a                 # path the lab is pinned to after bring-up and after every driver exit

# ---------------- hosts [paper] ----------------
LAN_A_NET=10.10.40.0/24        # publishers and background source (site A)
LAN_B_NET=10.10.30.0/24        # vIED (site B)
VMU1_IP=10.10.40.1
VMU2_IP=10.10.40.2
VMU3_IP=10.10.40.3
LOAD_IP=10.10.40.10
VIED_IP=10.10.30.1
# Differs from the paper lab: there the two routers were the hosts' IP gateways (.100). Here the
# sites are joined at Layer 2 by the tunnel, so each host has an on-link route to the other site.

# ---------------- underlay, path A (ovs-a - r1a - r2a - ovs-b) ----------------
A_TUN=vxa
A_VNI=101
A_NET1=10.10.51.0/30           # ovs-a -- r1a
A_OVSA_DEV=eth5
A_OVSA_IP=10.10.51.1           # tunnel A endpoint on ovs-a
A_R1_UP_IP=10.10.51.2          # r1a eth1
A_NET2=10.10.52.0/30           # r1a -- r2a
A_R1_DN_IP=10.10.52.1          # r1a eth2
A_R2_UP_IP=10.10.52.2          # r2a eth1
A_NET3=10.10.53.0/30           # r2a -- ovs-b
A_R2_DN_IP=10.10.53.1          # r2a eth2
A_OVSB_DEV=eth1
A_OVSB_IP=10.10.53.2           # tunnel A endpoint on ovs-b
A_DELAY_MS=2.5                 # netem per router, per direction [paper]

# ---------------- underlay, path B (ovs-a - r1b - r2b - ovs-b) ----------------
B_TUN=vxb
B_VNI=102
B_NET1=10.10.61.0/30
B_OVSA_DEV=eth6
B_OVSA_IP=10.10.61.1
B_R1_UP_IP=10.10.61.2
B_NET2=10.10.62.0/30
B_R1_DN_IP=10.10.62.1
B_R2_UP_IP=10.10.62.2
B_NET3=10.10.63.0/30
B_R2_DN_IP=10.10.63.1
B_OVSB_DEV=eth2
B_OVSB_IP=10.10.63.2
B_DELAY_MS=2.5                 # default; a run can override it (mp_sweep.py --delay-b-ms)

# ---------------- tunnels ----------------
VXLAN_PORT=4789
TUNNEL_OVERHEAD_B=50           # outer Ethernet 14 + IPv4 20 + UDP 8 + VXLAN 8
UNDERLAY_MTU=9550              # host links stay at the containerlab default 9500 [paper]; +50 so that
                               # any packet a host can send fits the tunnel without fragmentation
OVSB_LAN_DEV=eth3              # ovs-b port to the vIED (not shaped)
# BFD: enabled on every tunnel interface with the OVS defaults (no timer is set here on purpose;
# the driver prints the timers it reads back).

# ---------------- marking [paper] ----------------
EF_TOS=184                     # DSCP 46 (EF) = TOS 0xb8, set on the inner header at ovs-a ingress
SV_PORTS="102 103 104 105 106" # one UDP port per R-SV session; 105/106 are the load-only streams

# ---------------- shaping (kbit/s) ----------------
CEIL_KBIT=37500                # link ceiling, every shaped interface     [x1.25] paper 30000
EF_RATE_KBIT=25000             # EF class rate (guarantee)                [x1.25] paper 20000
EF_CEIL_KBIT=37500             # EF ceiling, work-conserving              [x1.25] paper 30000
BE_ACCESS_RATE_KBIT=1250       # best-effort rate at the access hop       [x1.25] paper 1000
BE_ROUTER_RATE_KBIT=12500      # best-effort rate on the routers          [x1.25] paper 10000
# HTB details copied unchanged [paper]: the kernel would derive other quanta from the scaled rates.
ACCESS_BURST_B=9564            # burst = cburst of both access-hop classes
ACCESS_ROOT_BURST_B=9499       # burst = cburst of the access-hop root class
ACCESS_MPU_B=60
ACCESS_EF_QUANTUM=200000
ACCESS_BE_QUANTUM=12500
ROUTER_EF_QUANTUM=200000
ROUTER_BE_QUANTUM=125000
# (router bursts are tc's default, 1600 B, as in the paper lab; queue length 1000 packets everywhere)

# ---------------- traffic accounting ----------------
RSV_FRAME_B=198                # R-SV frame on the LAN [paper]; 248 B inside the tunnel
SV_PPS=4000                    # samples (= frames) per second per stream [paper]
BG_PAYLOAD_B=1200              # iperf3 -l [paper]
BG_FRAME_B=1242                # background frame on the LAN [paper]; 1292 B inside the tunnel

# Background levels: iperf3 -b in kbit/s, chosen so that the offered load is the SAME FRACTION OF THE
# CEILING AT THE SHAPER as in the paper's campaign (which ran 94.4 / 108.2 / 125.5 / 146.2 % at
# Layer 2 under the labels 90 / 105 / 120 / 140 %). Counted at the tunnel layer:
#   -b = (paper_fraction x 37.5 - 23.808) x 1200/1292     (23.808 Mb/s = 3 streams x 248 B x 4000/s)
BG_60_KBPS=0                   # no background: R-SV alone, 63.5 % of the ceiling (paper 63.4 %)
BG_90_KBPS=10770               # paper -b 9M
BG_105_KBPS=15577              # paper -b 13M
BG_120_KBPS=21585              # paper -b 18M
BG_140_KBPS=28794              # paper -b 24M

# ---------------- acceptance reference [paper] ----------------
T_TRIP_REF_MS=18.3
T_TRIP_TOL_MS=1.0              # owner's default: report if a path's mean differs by more
T_TRIP_BUDGET_MS=20
PING_RTT_REF_MS=10.13
