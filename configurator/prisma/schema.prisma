generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider              = "zod-prisma-types"
  output                = "./zod"
  createRelationValuesTypes = true
}

datasource db {
  provider = "postgresql"
  url      =  env("DATABASE_URL")
}

model User {
  id             String    @id
  email          String    @unique
  hashedPassword String
  name           String?
  sessions       Session[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)
}

model GooseSetting {
  id                String   @id @default(cuid())
  vlanPriority      Int
  vlanId            Int
  appId             Int
  dstAddress        String?
  ethernetInterface String
  useVlanTag        Boolean?
  goId              String
  goCb              String
  timeAllowedToLive Int
  dataSetRef        String
  simulation        Boolean?
  confRev           Int
  ndsCom            Boolean?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SampledValuesSetting {
  id                String  @id @default(cuid())
  appId             Int
  ethernetInterface String
  dstAddressCheck   Boolean
  threshold         Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SampledValue {
  id         Int                      @id @default(autoincrement())
  time       DateTime
  value      Float
  filtered Boolean @default(false)
  @@map("sensor_data")
  @@index([time])
}